---
import ConnectionConfig from '../components/ConnectionConfig.astro';
import Layout from '../layout.astro';
import TableData from '../components/TableData.astro';
import { Button, Heading } from '@coffic/cosy-ui';
---

<Layout title="Cosy Data Hub - 数据库管理工具">
    <!-- 应用状态容器 -->
    <div id="appContainer" class="h-full">
        <!-- 连接配置页面 -->
        <div
            id="connectionPage"
            class="h-full flex items-center justify-center">
            <div class="w-full max-w-4xl mx-auto p-6">
                <div class="text-center mb-8">
                    <h1
                        class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
                        Cosy Data Hub
                    </h1>
                    <p class="text-xl text-gray-600 dark:text-gray-400">
                        强大的数据库管理工具
                    </p>
                </div>

                <!-- 连接配置组件 -->
                <ConnectionConfig />
            </div>
        </div>

        <!-- 数据库管理页面 -->
        <div id="databasePage" class="hidden h-full">
            <div class="flex-1 flex flex-col overflow-hidden">
                <!-- 表数据展示区域 -->
                <div class="flex-1 overflow-y-auto p-6">
                    <TableData />
                </div>
            </div>
        </div>

        <!-- 加载状态 -->
        <div
            id="loadingPage"
            class="hidden h-full flex items-center justify-center">
            <div class="text-center">
                <svg
                    class="animate-spin mx-auto w-12 h-12 text-blue-500 mb-4"
                    fill="none"
                    viewBox="0 0 24 24">
                    <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                    <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                </svg>
                <p class="text-lg text-gray-600 dark:text-gray-400">
                    连接数据库中...
                </p>
            </div>
        </div>
    </div>
</Layout>

<script>
    // 页面元素
    const connectionPage = document.getElementById('connectionPage');
    const databasePage = document.getElementById('databasePage');
    const loadingPage = document.getElementById('loadingPage');
    const disconnectBtn = document.getElementById(
        'disconnectBtn'
    ) as HTMLButtonElement;
    const connectionInfo = document.getElementById('connectionInfo');

    // 应用状态
    let isConnected = false;
    let connectionInfoData: any = null;

    // 显示连接页面
    function showConnectionPage() {
        connectionPage?.classList.remove('hidden');
        databasePage?.classList.add('hidden');
        loadingPage?.classList.add('hidden');
    }

    // 显示数据库页面
    function showDatabasePage() {
        connectionPage?.classList.add('hidden');
        databasePage?.classList.remove('hidden');
        loadingPage?.classList.add('hidden');
    }

    // 显示加载页面
    function showLoadingPage() {
        connectionPage?.classList.add('hidden');
        databasePage?.classList.add('hidden');
        loadingPage?.classList.remove('hidden');
    }

    // 处理数据库连接成功
    function handleDatabaseConnected(event: CustomEvent) {
        isConnected = true;
        connectionInfoData = event.detail;

        // 保存连接信息到 localStorage
        if (connectionInfoData.filename) {
            localStorage.setItem(
                'lastConnectionPath',
                connectionInfoData.filename
            );
        }

        // 显示数据库管理界面
        showDatabasePage();

        // 触发连接信息更新事件，让其他组件获取连接信息
        window.dispatchEvent(
            new CustomEvent('connection-info-updated', {
                detail: connectionInfoData,
            })
        );
    }

    // 处理数据库断开连接
    function handleDatabaseDisconnected() {
        isConnected = false;
        connectionInfoData = null;

        // 移除 localStorage 中的连接信息
        localStorage.removeItem('lastConnectionPath');

        // 显示连接配置页面
        showConnectionPage();

        // 通知其他组件数据库已断开
        window.dispatchEvent(new CustomEvent('database-disconnected'));
    }

    // 处理连接开始
    function handleConnectionStart() {
        showLoadingPage();
    }

    // 处理连接失败
    function handleConnectionError(event: CustomEvent) {
        showConnectionPage();

        // 显示错误信息
        const errorMessage = event.detail?.error || '连接失败';
        console.error('Database connection error:', errorMessage);

        // 可以在这里添加错误提示显示逻辑
    }

    // 断开连接
    if (disconnectBtn) {
        disconnectBtn.addEventListener('click', async () => {
            const btn = disconnectBtn as HTMLButtonElement;
            try {
                btn.disabled = true;
                btn.textContent = '断开中...';

                // 调用断开连接 action
                const { actions } = await import('astro:actions');
                const result = await actions.disconnectDatabase({});

                if (result.data?.success) {
                    // 触发断开连接事件
                    window.dispatchEvent(
                        new CustomEvent('database-disconnect')
                    );
                } else {
                    console.error('断开连接失败:', result.data?.error);
                    // 即使失败也触发断开连接事件，让界面返回到连接页面
                    window.dispatchEvent(
                        new CustomEvent('database-disconnect')
                    );
                }
            } catch (error) {
                console.error('断开连接失败:', (error as Error).message);
                // 即使失败也触发断开连接事件，让界面返回到连接页面
                window.dispatchEvent(new CustomEvent('database-disconnect'));
            } finally {
                btn.disabled = false;
                btn.textContent = '断开连接';
            }
        });
    }

    // 监听连接状态更新
    window.addEventListener('connection-info-updated', (e: Event) => {
        const event = e as CustomEvent;
        if (connectionInfo && event.detail) {
            const { filename, connectedAt } = event.detail;
            connectionInfo.innerHTML = `
        <div>文件: ${filename}</div>
        <div>连接时间: ${new Date(connectedAt).toLocaleString()}</div>
      `;
        }
    });

    // 事件监听
    window.addEventListener('database-connection-start', handleConnectionStart);
    window.addEventListener(
        'database-connected',
        handleDatabaseConnected as EventListener
    );
    window.addEventListener(
        'database-connection-error',
        handleConnectionError as EventListener
    );
    window.addEventListener('database-disconnect', handleDatabaseDisconnected);

    // 页面加载完成后的初始化
    document.addEventListener('DOMContentLoaded', () => {
        // 检查是否已有连接（页面刷新后恢复状态）
        checkExistingConnection();
    });

    // 检查现有连接状态
    async function checkExistingConnection() {
        const lastConnectionPath = localStorage.getItem('lastConnectionPath');
        if (lastConnectionPath) {
            showLoadingPage();
            try {
                const { actions } = await import('astro:actions');
                const result = await actions.connectToDatabase({
                    type: 'sqlite',
                    filename: lastConnectionPath,
                });

                // 首先检查 action 本身是否出错
                if (result.error) {
                    throw new Error(result.error.message);
                }

                if (result.data.success) {
                    // 触发连接成功事件，后续逻辑由事件监听器处理
                    window.dispatchEvent(
                        new CustomEvent('database-connected', {
                            detail: {
                                filename: lastConnectionPath,
                                connectedAt: new Date().toISOString(),
                                connectionId: result.data.connectionId,
                            },
                        })
                    );
                } else {
                    window.dispatchEvent(
                        new CustomEvent('database-connection-error', {
                            detail: {
                                error: result.data.error || '自动重新连接失败',
                            },
                        })
                    );
                    localStorage.removeItem('lastConnectionPath'); // 清除无效的路径
                }
            } catch (error) {
                window.dispatchEvent(
                    new CustomEvent('database-connection-error', {
                        detail: { error: (error as Error).message },
                    })
                );
                localStorage.removeItem('lastConnectionPath'); // 清除无效的路径
            }
        } else {
            // 暂无保存的连接，显示连接页面
            showConnectionPage();
        }
    }

    // 全局状态访问器（供其他组件使用）
    (window as any).getAppState = () => ({
        isConnected,
        connectionInfo: connectionInfoData,
    });
</script>
