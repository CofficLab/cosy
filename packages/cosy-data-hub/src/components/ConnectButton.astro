---
import { Button } from '@coffic/cosy-ui';
---

<Button id="connect">连接</Button>

<script>
    import { actions } from 'astro:actions';
    import { showStatus } from '../scripts/utils.ts';

    const connectBtn = document.getElementById('connect') as HTMLButtonElement;
    const dbPathInput = document.getElementById('dbPath') as HTMLInputElement;

    connectBtn?.addEventListener('click', async () => {
        const filename = dbPathInput?.value.trim();
        if (!filename) {
            showStatus('请输入数据库文件路径', 'error');
            return;
        }

        try {
            connectBtn.disabled = true;
            connectBtn.textContent = '连接中...';

            // 触发连接开始事件
            window.dispatchEvent(new CustomEvent('database-connection-start'));

            const result = await actions.connectToDatabase({
                type: 'sqlite',
                filename,
            });

            if (result.data?.success) {
                showStatus('数据库连接成功！', 'success');

                // 触发连接成功事件，传递连接信息
                window.dispatchEvent(
                    new CustomEvent('database-connected', {
                        detail: {
                            filename,
                            type: 'sqlite',
                            connectedAt: new Date().toISOString(),
                        },
                    })
                );
            } else {
                const errorMessage = result.data?.error || '未知错误';
                showStatus(`连接失败: ${errorMessage}`, 'error');

                // 触发连接失败事件
                window.dispatchEvent(
                    new CustomEvent('database-connection-error', {
                        detail: {
                            error: errorMessage,
                        },
                    })
                );
            }
        } catch (error) {
            const errorMessage = (error as Error).message;
            showStatus(`连接失败: ${errorMessage}`, 'error');

            // 触发连接失败事件
            window.dispatchEvent(
                new CustomEvent('database-connection-error', {
                    detail: {
                        error: errorMessage,
                    },
                })
            );
        } finally {
            connectBtn.disabled = false;
            connectBtn.textContent = '连接';
        }
    });
</script>
