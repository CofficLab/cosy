---
import { HomeIcon, Heading, Text } from '@coffic/cosy-ui';
---

<div id="tableDataSection" class="h-full flex flex-col">
    <!-- 欢迎页面 -->
    <div id="welcomePage" class="flex-1 flex items-center justify-center">
        <div class="text-center">
            <div
                class="mx-auto w-24 h-24 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center mb-6">
                <HomeIcon />
            </div>
            <Heading level={2}>选择一个表查看数据</Heading>
            <Text> 从左侧导航栏中选择一个数据表，查看表结构和数据内容。 </Text>
        </div>
    </div>

    <!-- 表数据展示 -->
    <div id="tableDataContent" class="hidden h-full flex flex-col">
        <!-- 表头信息 -->
        <div class="border-b border-gray-200 dark:border-gray-700 pb-4 mb-6">
            <div class="flex items-center justify-between">
                <div>
                    <h1
                        id="tableTitle"
                        class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                        <!-- 表名将在这里显示 -->
                    </h1>
                    <p
                        id="tableInfo"
                        class="text-gray-600 dark:text-gray-400 mt-1">
                        <!-- 表信息将在这里显示 -->
                    </p>
                </div>
                <div class="flex space-x-2">
                    <button
                        id="refreshDataBtn"
                        class="px-4 py-2 text-sm bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors">
                        刷新数据
                    </button>
                </div>
            </div>
        </div>

        <!-- 数据表格 -->
        <div class="flex-1 overflow-auto">
            <div id="tableData" class="min-w-full">
                <!-- 表格内容将在这里显示 -->
            </div>
        </div>

        <!-- 分页信息 -->
        <div
            id="paginationInfo"
            class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-400">
            <!-- 分页信息将在这里显示 -->
        </div>
    </div>

    <!-- 错误状态 -->
    <div id="errorState" class="hidden flex-1 flex items-center justify-center">
        <div class="text-center">
            <div
                class="mx-auto w-24 h-24 bg-red-100 dark:bg-red-900 rounded-full flex items-center justify-center mb-6">
                <svg
                    class="w-12 h-12 text-red-500 dark:text-red-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                </svg>
            </div>
            <h2
                class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-3">
                加载数据失败
            </h2>
            <p
                id="errorMessage"
                class="text-gray-600 dark:text-gray-400 max-w-md">
                <!-- 错误信息将在这里显示 -->
            </p>
        </div>
    </div>
</div>

<script>
    const welcomePage = document.getElementById('welcomePage');
    const tableDataContent = document.getElementById('tableDataContent');
    const errorState = document.getElementById('errorState');
    const tableTitle = document.getElementById('tableTitle');
    const tableInfo = document.getElementById('tableInfo');
    const tableData = document.getElementById('tableData');
    const refreshDataBtn = document.getElementById('refreshDataBtn');
    const paginationInfo = document.getElementById('paginationInfo');
    const errorMessage = document.getElementById('errorMessage');

    let currentTableName: string | null = null;

    // 显示欢迎页面
    function showWelcomePage() {
        welcomePage?.classList.remove('hidden');
        tableDataContent?.classList.add('hidden');
        errorState?.classList.add('hidden');
    }

    // 显示表数据
    function showTableData() {
        welcomePage?.classList.add('hidden');
        tableDataContent?.classList.remove('hidden');
        errorState?.classList.add('hidden');
    }

    // 显示错误状态
    function showErrorState(message: string) {
        welcomePage?.classList.add('hidden');
        tableDataContent?.classList.add('hidden');
        errorState?.classList.remove('hidden');
        if (errorMessage) {
            errorMessage.textContent = message;
        }
    }

    // 渲染表格数据
    function renderTableData(tableName: string, result: any) {
        if (!tableData || !tableTitle || !tableInfo || !paginationInfo) return;

        // 更新表头信息
        tableTitle.textContent = tableName;
        tableInfo.textContent = `共 ${result.total} 行数据`;

        // 更新分页信息
        const displayedRows = result.data.length;
        paginationInfo.textContent = `显示 ${displayedRows} 行，共 ${result.total} 行`;

        if (result.data.length === 0) {
            tableData.innerHTML = `
        <div class="text-center py-12">
          <svg class="mx-auto w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2 2v-5m16 0h-6a2 2 0 00-2 2v3a2 2 0 002 2h6a2 2 0 002-2v-3a2 2 0 00-2-2z"></path>
          </svg>
          <p class="mt-4 text-gray-500 dark:text-gray-400">表 "${tableName}" 中没有数据</p>
        </div>
      `;
            return;
        }

        const columns = Object.keys(result.data[0]);

        tableData.innerHTML = `
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            ${columns
                .map(
                    (col) => `
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                ${col}
              </th>
            `
                )
                .join('')}
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          ${result.data
              .map(
                  (row: any, index: number) => `
            <tr class="${index % 2 === 0 ? 'bg-white dark:bg-gray-800' : 'bg-gray-50 dark:bg-gray-750'} hover:bg-gray-100 dark:hover:bg-gray-700">
              ${columns
                  .map(
                      (col) => `
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-200">
                  <div class="max-w-xs truncate" title="${String(row[col] || '')}">
                    ${String(row[col] || '')}
                  </div>
                </td>
              `
                  )
                  .join('')}
            </tr>
          `
              )
              .join('')}
        </tbody>
      </table>
    `;
    }

    // 加载表数据
    async function loadTableData(tableName: string) {
        try {
            currentTableName = tableName;

            // 显示加载状态
            if (tableData) {
                tableData.innerHTML = `
          <div class="text-center py-12">
            <svg class="animate-spin mx-auto w-8 h-8 text-blue-500" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="mt-2 text-gray-500">加载中...</p>
          </div>
        `;
            }

            const { actions } = await import('astro:actions');
            const result = await actions.getTableData({ tableName });

            if (result.data?.success) {
                renderTableData(tableName, result.data.data);
                showTableData();
            } else {
                showErrorState(result.data?.error || '加载数据失败');
            }
        } catch (error) {
            showErrorState((error as Error).message);
        }
    }

    // 刷新当前表数据
    if (refreshDataBtn) {
        refreshDataBtn.addEventListener('click', () => {
            if (currentTableName) {
                loadTableData(currentTableName);
            }
        });
    }

    // 监听查看表数据事件
    window.addEventListener('view-table', (event: any) => {
        const { tableName } = event.detail;
        loadTableData(tableName);
    });

    // 监听数据库断开连接事件
    window.addEventListener('database-disconnect', () => {
        currentTableName = null;
        showWelcomePage();
    });

    // 初始显示欢迎页面
    showWelcomePage();
</script>
