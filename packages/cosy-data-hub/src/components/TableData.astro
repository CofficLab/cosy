---
import WelcomePage from './WelcomePage.astro';
import ErrorState from './ErrorState.astro';
import TableToolbar from './TableToolbar.astro';
import DataTable from './DataTable.astro';
import PaginationInfo from './PaginationInfo.astro';
import { getTableDataHandler } from '../actions/getTableData';

export interface Props {
    tableName: string | null;
}

type WelcomeContent = { type: 'welcome' };
type ErrorContent = { type: 'error'; message: string };
type DataContent = { type: 'data'; data: any[]; total: number };
type Content = WelcomeContent | ErrorContent | DataContent;

const { tableName } = Astro.props;

let content: Content;
if (!tableName) {
    content = { type: 'welcome' };
} else {
    try {
        const result = await getTableDataHandler({ tableName });
        if (result.success && result.data) {
            content = {
                type: 'data',
                data: result.data.data || [],
                total: result.data.total || 0,
            };
        } else {
            throw new Error(result.error || '加载数据时发生未知错误');
        }
    } catch (error) {
        content = {
            type: 'error',
            message: error instanceof Error ? error.message : '加载数据失败',
        };
    }
}
---

<div class="h-full flex flex-col">
    {content.type === 'welcome' && <WelcomePage />}
    {content.type === 'error' && <ErrorState message={content.message} />}
    {
        content.type === 'data' && tableName && (
            <div class="h-full flex flex-col">
                <TableToolbar tableName={tableName} rowCount={content.total} />
                <div class="flex-1 overflow-auto">
                    <DataTable data={content.data} />
                </div>
                <PaginationInfo
                    displayedRows={content.data.length}
                    totalRows={content.total}
                />
            </div>
        )
    }
</div>

<script>
    // Since rendering is now server-side, we only need to handle the refresh event.
    window.addEventListener('refresh-table-data', (event) => {
        const detail = (event as CustomEvent).detail;
        if (detail.tableName) {
            // The simplest way to refresh in Astro is to reload the page with the correct query param.
            window.location.search = `?name=${detail.tableName}`;
        }
    });
</script>
