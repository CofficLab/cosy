---
// ConnectionConfig.astro - 数据库连接配置组件
import FileExplorer from './FileExplorer.astro';
import BrowseButton from './BrowseButton.astro';
import ConnectButton from './ConnectButton.astro';
import CreateTestDbButton from './CreateTestDbButton.astro';
import TestConnectionButton from './TestConnectionButton.astro';
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-200">
        数据库连接
    </h2>
    <div class="flex gap-4 items-end">
        <div class="flex-1">
            <label
                for="dbPath"
                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                数据库文件路径
            </label>
            <div class="flex gap-2">
                <input
                    type="text"
                    id="dbPath"
                    placeholder="点击右侧`浏览`按钮选择文件"
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <BrowseButton />
            </div>
        </div>
        <CreateTestDbButton />
        <TestConnectionButton />
        <ConnectButton />
    </div>
    <div id="connectionStatus" class="mt-4 text-sm"></div>
</div>

<div id="fileExplorerWrapper" class="hidden mt-4">
    <FileExplorer />
</div>

<script>
    // DOM 元素
    const dbPathInput = document.getElementById('dbPath') as HTMLInputElement;
    const fileExplorerWrapper = document.getElementById(
        'fileExplorerWrapper'
    ) as HTMLDivElement;

    // 监听文件选择事件
    window.addEventListener('file-selected', (e: Event) => {
        const event = e as CustomEvent;
        if (dbPathInput && event.detail.path) {
            dbPathInput.value = event.detail.path;
            fileExplorerWrapper.classList.add('hidden'); // 选择后自动隐藏
        }
    });
</script>
