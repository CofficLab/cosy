---
import { Button } from '@coffic/cosy-ui';
---

<Button id="createTestDb"> 创建测试库 </Button>

<script>
    import { actions } from 'astro:actions';
    import { showStatus } from '../../scripts/utils.ts';

    const createTestDbBtn = document.getElementById(
        'createTestDb'
    ) as HTMLButtonElement;
    const dbPathInput = document.getElementById('dbPath') as HTMLInputElement;

    createTestDbBtn?.addEventListener('click', async () => {
        try {
            createTestDbBtn.disabled = true;
            createTestDbBtn.textContent = '创建中...';
            const result = await actions.createTestDatabase();

            if (result.data?.success) {
                showStatus(result.data.message || '操作成功', 'success');
                if (dbPathInput && result.data.path) {
                    dbPathInput.value = result.data.path;
                }
            } else {
                showStatus(
                    `创建失败: ${result.data?.error || '未知错误'}`,
                    'error'
                );
            }
        } catch (error) {
            showStatus(`创建失败: ${(error as Error).message}`, 'error');
        } finally {
            createTestDbBtn.disabled = false;
            createTestDbBtn.textContent = '创建测试库';
        }
    });
</script>
