---
export interface Props {
    message: string;
}
const { message } = Astro.props;
---

<div class="flex-1 flex items-center justify-center">
    <div class="text-center">
        <div
            class="mx-auto w-24 h-24 bg-red-100 dark:bg-red-900 rounded-full flex items-center justify-center mb-6">
            <svg
                class="w-12 h-12 text-red-500 dark:text-red-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
            </svg>
        </div>
        <h2
            class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-3">
            加载数据失败
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-md">
            {message}
        </p>
    </div>
</div>
