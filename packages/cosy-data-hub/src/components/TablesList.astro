---
// TablesList.astro - 数据表列表组件
interface TableInfo {
  name: string;
  rowCount: number;
  columns: Array<{ name: string; type: string }>;
}
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
  <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-200">数据表</h2>
  <ul id="tablesList" class="divide-y divide-gray-200 dark:divide-gray-600">
    <p class="text-gray-500">请先连接数据库</p>
  </ul>
</div>

<script>
  import type { ITableInfo } from '../types/database';

  const tablesList = document.getElementById('tablesList');

  // 显示表列表
  function displayTables(tables: ITableInfo[]) {
    if (!tablesList) return;

    if (tables.length === 0) {
      tablesList.innerHTML = '<li class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">没有找到任何表。</li>';
      return;
    }

    tables.forEach(table => {
      const li = document.createElement('li');
      li.className = 'px-4 py-3 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-150';
      li.textContent = table.name;
      li.dataset.tableName = table.name;
      tablesList.appendChild(li);
    });
  }

  // 加载表列表
  async function loadTables() {
    try {
      const { actions } = await import('astro:actions');
      const result = await actions.getTables({});

      if (result.data?.success) {
        displayTables(result.data.data);
      } else {
        console.error('加载表列表失败:', result.data?.error);
      }
    } catch (error) {
      console.error('加载表列表失败:', (error as Error).message);
    }
  }

  // 监听数据库连接事件
  window.addEventListener('database-connected', () => {
    loadTables();
  });

  // 全局函数，供按钮点击使用
  (window as any).viewTable = async (tableName: string) => {
    // 触发自定义事件，让 TableData 组件处理
    window.dispatchEvent(new CustomEvent('view-table', {
      detail: { tableName }
    }));
  };
</script>
