---
import { Button, Heading } from '@coffic/cosy-ui';
---

<div class="p-4">
    <Heading level={3}>数据表</Heading>

    <div id="tablesContainer">
        <ul id="tablesList" class="space-y-1">
            <li class="text-gray-500 dark:text-gray-400 text-sm py-2">
                加载中...
            </li>
        </ul>
    </div>

    <!-- 刷新按钮 -->
    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
        <Button id="refreshTablesBtn"> 刷新表列表 </Button>
    </div>
</div>

<script>
    import type { ITableInfo } from '../types/database';

    const tablesList = document.getElementById('tablesList');
    const refreshTablesBtn = document.getElementById('refreshTablesBtn');

    // 显示表列表
    function displayTables(tables: ITableInfo[]) {
        if (!tablesList) return;

        if (tables.length === 0) {
            tablesList.innerHTML = `
        <li class="text-gray-500 dark:text-gray-400 text-sm py-2">
          没有找到任何表
        </li>
      `;
            return;
        }

        tablesList.innerHTML = '';

        tables.forEach((table) => {
            const li = document.createElement('li');
            li.className = `
        px-3 py-2 rounded-md cursor-pointer transition-colors duration-150
        hover:bg-gray-100 dark:hover:bg-gray-700
        group relative
      `;

            li.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="flex-1 min-w-0">
            <div class="text-sm font-medium text-gray-900 dark:text-gray-200 truncate">
              ${table.name}
            </div>
            <div class="text-xs text-gray-500 dark:text-gray-400">
              ${table.rowCount || 0} 行
            </div>
          </div>
          <div class="text-xs text-gray-400 dark:text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      `;

            li.dataset.tableName = table.name;

            // 点击事件
            li.addEventListener('click', () => {
                selectTable(table.name);
            });

            tablesList.appendChild(li);
        });
    }

    // 选择表
    function selectTable(tableName: string) {
        // 更新选中状态
        updateSelectedTable(tableName);

        // 触发查看表数据事件
        window.dispatchEvent(
            new CustomEvent('view-table', {
                detail: { tableName },
            })
        );
    }

    // 更新选中状态
    function updateSelectedTable(tableName: string) {
        // 移除所有选中状态
        const allItems = tablesList?.querySelectorAll('li[data-table-name]');
        allItems?.forEach((item) => {
            item.classList.remove(
                'bg-blue-100',
                'dark:bg-blue-900',
                'border-l-2',
                'border-blue-500'
            );
        });

        // 添加选中状态
        const selectedItem = tablesList?.querySelector(
            `li[data-table-name="${tableName}"]`
        );
        if (selectedItem) {
            selectedItem.classList.add(
                'bg-blue-100',
                'dark:bg-blue-900',
                'border-l-2',
                'border-blue-500'
            );
        }
    }

    // 加载表列表
    async function loadTables() {
        try {
            if (!tablesList) return;

            tablesList.innerHTML = `
        <li class="text-gray-500 dark:text-gray-400 text-sm py-2">
          加载中...
        </li>
      `;

            const { actions } = await import('astro:actions');
            const result = await actions.getTables({});

            if (result.data?.success) {
                displayTables(result.data.data);
            } else {
                tablesList.innerHTML = `
          <li class="text-red-500 text-sm py-2">
            加载失败: ${result.data?.error || '未知错误'}
          </li>
        `;
            }
        } catch (error) {
            if (tablesList) {
                tablesList.innerHTML = `
          <li class="text-red-500 text-sm py-2">
            加载失败: ${(error as Error).message}
          </li>
        `;
            }
        }
    }

    // 刷新按钮事件
    if (refreshTablesBtn) {
        refreshTablesBtn.addEventListener('click', loadTables);
    }

    // 监听数据库连接事件
    window.addEventListener('database-connected', () => {
        loadTables();
    });

    // 监听数据库断开连接事件
    window.addEventListener('database-disconnect', () => {
        if (tablesList) {
            tablesList.innerHTML = `
        <li class="text-gray-500 dark:text-gray-400 text-sm py-2">
          请先连接数据库
        </li>
      `;
        }
    });

    // 初始加载
    loadTables();
</script>
