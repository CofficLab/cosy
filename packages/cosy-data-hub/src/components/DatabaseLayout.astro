---
// DatabaseLayout.astro - 数据库管理主界面布局
import TablesList from './TablesList.astro';
import TableData from './TableData.astro';
---

<div class="h-screen flex bg-gray-50 dark:bg-gray-900">
    <!-- 左侧导航栏 - 表列表 -->
    <div
        class="w-80 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col">
        <!-- 连接状态头部 -->
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <h2
                    class="text-lg font-semibold text-gray-800 dark:text-gray-200">
                    数据库连接
                </h2>
                <button
                    id="disconnectBtn"
                    class="px-3 py-1 text-sm bg-red-500 text-white rounded hover:bg-red-600 transition-colors disabled:opacity-50">
                    断开连接
                </button>
            </div>
            <div
                id="connectionInfo"
                class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                <!-- 连接信息将在这里显示 -->
            </div>
        </div>

        <!-- 表列表区域 -->
        <div class="flex-1 overflow-y-auto">
            <TablesList />
        </div>
    </div>

    <!-- 右侧主内容区 -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- 表数据展示区域 -->
        <div class="flex-1 overflow-y-auto p-6">
            <TableData />
        </div>
    </div>
</div>

<script>
    const disconnectBtn = document.getElementById(
        'disconnectBtn'
    ) as HTMLButtonElement;
    const connectionInfo = document.getElementById('connectionInfo');

    // 断开连接
    if (disconnectBtn) {
        disconnectBtn.addEventListener('click', async () => {
            const btn = disconnectBtn as HTMLButtonElement;
            try {
                btn.disabled = true;
                btn.textContent = '断开中...';

                // 调用断开连接 action
                const { actions } = await import('astro:actions');
                const result = await actions.disconnectDatabase({});

                if (result.data?.success) {
                    // 触发断开连接事件
                    window.dispatchEvent(
                        new CustomEvent('database-disconnect')
                    );
                } else {
                    console.error('断开连接失败:', result.data?.error);
                    // 即使失败也触发断开连接事件，让界面返回到连接页面
                    window.dispatchEvent(
                        new CustomEvent('database-disconnect')
                    );
                }
            } catch (error) {
                console.error('断开连接失败:', (error as Error).message);
                // 即使失败也触发断开连接事件，让界面返回到连接页面
                window.dispatchEvent(new CustomEvent('database-disconnect'));
            } finally {
                btn.disabled = false;
                btn.textContent = '断开连接';
            }
        });
    }

    // 监听连接状态更新
    window.addEventListener('connection-info-updated', (e: Event) => {
        const event = e as CustomEvent;
        if (connectionInfo && event.detail) {
            const { filename, connectedAt } = event.detail;
            connectionInfo.innerHTML = `
        <div>文件: ${filename}</div>
        <div>连接时间: ${new Date(connectedAt).toLocaleString()}</div>
      `;
        }
    });
</script>
