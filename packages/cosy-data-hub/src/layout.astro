---
import { DashboardLayout, type NavItem } from '@coffic/cosy-ui';
import './styles/global.css';

const navItems: NavItem[] = [{ href: '/', text: '数据库', icon: 'database' }];

export interface Props {
    title?: string;
}

const { title = 'Data Hub' } = Astro.props;
---

<DashboardLayout
    title={title}
    systemName="Cosy Data Hub"
    navItems={navItems}
    userName="Developer"
    mainPadding="none">
    <slot />
</DashboardLayout>
