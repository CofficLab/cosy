---
import { DashboardLayout, type NavItem } from '@coffic/cosy-ui';
import './styles/global.css';
import TablesList from './components/TablesList.astro';
import ConnectionStatus from './components/ConnectionStatus.astro';

const navItems: NavItem[] = [];

export interface Props {
    title?: string;
}

const { title = 'Data Hub' } = Astro.props;
---

<DashboardLayout
    title={title}
    systemName="Cosy Data Hub"
    navItems={navItems}
    userName="Developer"
    mainPadding="none">
    <slot />
    <div slot="sidebar-footer" class="p-4 space-y-4">
        <ConnectionStatus />
        <TablesList />
    </div>
</DashboardLayout>
