---
import { DashboardLayout, type NavItem } from '@coffic/cosy-ui';
import './styles/global.css';
import TablesList from './components/TablesList.astro';
import ConnectionStatus from './components/ConnectionStatus.astro';
import { actions } from 'astro:actions';
import { databaseManager } from './lib/database/database-manager';

let navItems: NavItem[] = [];

const tables = await databaseManager.getTables();
tables.forEach((table) => {
    navItems.push({
        text: table.name,
        href: `/tables/${table.name}`,
    });
});

export interface Props {
    title?: string;
}

const { title = 'Data Hub' } = Astro.props;
---

<DashboardLayout
    title={title}
    systemName="Cosy Data Hub"
    navItems={navItems}
    userName="Developer"
    mainPadding="none">
    <slot />
    <div slot="sidebar-footer">
        <ConnectionStatus />
        <TablesList />
    </div>
</DashboardLayout>
